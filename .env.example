# ==============================================================================
# RuleWise AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values.
# NEVER commit your actual .env file or sensitive API keys to version control.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# NLP & Timeout Configuration
MAX_INPUT_LENGTH=2000
LLM_TIMEOUT_SECONDS=3.5
